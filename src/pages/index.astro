---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames, getCatalogSummary } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const catalogSummary = await getCatalogSummary(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <section aria-label="Catalog summary" class="mb-8" data-testid="catalog-summary" >
      <div class="rounded-xl border border-slate-700 bg-slate-800/80 p-6 shadow-lg">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="rounded-lg border border-slate-700 bg-slate-900/50 p-4" data-testid="catalog-total-games">
            <p class="text-sm uppercase tracking-wide text-slate-400">Games in catalog</p>
            <p class="mt-2 text-3xl font-semibold text-slate-100" aria-label={`Total games: ${catalogSummary.totalGames}`}>
              {catalogSummary.totalGames}
            </p>
          </div>

          <div class="rounded-lg border border-slate-700 bg-slate-900/50 p-4" data-testid="catalog-average-rating">
            <p class="text-sm uppercase tracking-wide text-slate-400">Average rating</p>
            <p class="mt-2 text-3xl font-semibold text-slate-100" aria-label={catalogSummary.averageStarRating === null ? 'Average rating unavailable' : `Average rating: ${catalogSummary.averageStarRating.toFixed(1)} stars`}>
              {catalogSummary.averageStarRating === null ? 'N/A' : catalogSummary.averageStarRating.toFixed(1)}
            </p>
          </div>
        </div>
      </div>
    </section>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
    </div>
  </div>
</Layout>
